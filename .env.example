# Copia este archivo como .env y completa los valores.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True

# PostgreSQL
DB_NAME=vehiculos
DB_USER=postgres
DB_PASSWORD=tu-contraseña-de-postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Hosts adicionales separados por comas (opcional), p. ej. la IP del PC en la red local
ALLOWED_HOSTS_EXTRA=

# Telegram Bot API (notificaciones de alertas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail SMTP (notificaciones por correo electrónico)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=10
SITE_URL=http://localhost:8080

# WhatsApp Cloud API de Meta (usa en WHATSAPP_API_VERSION la versión que muestra el panel de Meta, p. ej. v21.0)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=

# Envío de notificaciones en segundo plano (True por defecto)
NOTIFICACIONES_ASINCRONAS=True
